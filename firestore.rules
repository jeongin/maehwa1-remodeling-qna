rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in
           get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // 명부에 등록된 계정만 정상 조합원으로 본다.
    // 명부 문서가 없는 계정은 FAQ 열람도 질문 등록도 되지 않는다.
    function verified() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // 관리자 이메일 목록. 콘솔에서만 수정한다.
    match /config/admins {
      allow read: if signedIn();
      allow write: if false;
    }

    // 자주 묻는 질문 — 명부에 등록된 조합원과 관리자만 열람, 관리자만 작성.
    match /qa_items/{id} {
      allow read: if isAdmin() || verified();
      allow write: if isAdmin();
    }

    // 질문 게시판 — 작성자 본인과 관리자만 읽을 수 있다.
    match /questions/{id} {
      allow read: if isAdmin() || isAuthor();

      // 관리자는 답변까지 채워서 바로 등록할 수 있다.
      allow create: if isAdmin()
        || (verified()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.category in
           ['법무·세무·회계', '설계', '이주·이주비', '총회', '주민설명회', '기타']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000
        && request.resource.data.answer == ''
        && request.resource.data.status == 'pending');

      // 관리자는 답변을 달 수 있고, 작성자는 답변 전 자기 글만 고칠 수 있다.
      allow update: if isAdmin()
        || (isAuthor()
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.answer == resource.data.answer
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin() || isAuthor();
    }

    // 동·호수 명부. 본인과 관리자만 볼 수 있다.
    // 계정은 조합이 사전 등록하므로 클라이언트는 만들 수 없다.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if false;

      // 비밀번호 변경 기록 등. 동·호수는 바꿀 수 없다.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.dong == resource.data.dong
        && request.resource.data.ho == resource.data.ho;

      allow delete: if false;
    }
  }
}
